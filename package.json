  "dependencies": {
    "volunteer-contributions-fetch": "^3.1.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@playwright/test": "^1.64.1",
    "markdown-it": "^15.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "eleventy",
    "fetch": "DEBUG=contributions* node scripts/fetch.mjs",
    "start": "eleventy --serve --incremental",
