{
  "name": "mkohler.dev",
  "version": "3.2.0",
  "description": "Michael Kohler's CV",
  "author": "Michael Kohler",
  "license": "MIT",
  "dependencies": {
    "volunteer-contributions-fetch": "^3.1.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@playwright/test": "^1.64.1",
    "@shopify/prettier-plugin-liquid": "^1.11.3",
    "markdown-it": "^15.0.3",
    "prettier": "^3.9.10"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "eleventy",
    "fetch": "DEBUG=contributions* node scripts/fetch.mjs && node scripts/dedupe-contributions.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "start": "eleventy --serve --incremental",
    "test": "npm run test:api && rm -rf _site && npm run build && npm run test:links && npm run test:playwright",
    "test:api": "node --test \"tests/api/*.test.mjs\"",
    "test:links": "node --test \"tests/links/*.test.mjs\"",
    "test:playwright": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:update": "playwright test --update-snapshots"
  }
}
