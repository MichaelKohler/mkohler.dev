---
layout: "base.liquid"
---
<section id="blogpost" class="page">
  <div class="intro">
    <a href="/blog/" class="small" lang="en">← Back to blog post overview</a>

    <h1
      {% if title_lang %}
        lang="{{ title_lang }}"
      {% endif %}
    >
      {{ title }}
    </h1>
    <p class="date" lang="en">{{ date | date: "%Y-%m-%d at %H:%M:%S" }}</p>
  </div>

  <div class="content">
    {{ content }}
  </div>
</section>
